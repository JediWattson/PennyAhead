# Default needs no API credentials. Values below are server-only.
PENNYAHEAD_ASSISTANT=mock
PENNYAHEAD_TRANSFER_PROVIDER=local_simulation
# PENNYAHEAD_MONITOR_DB=/absolute/persistent/path/monitor.sqlite
# Set openai only after configuring a key via the secure setup flow.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Or set PENNYAHEAD_ASSISTANT=bedrock and use a limited AWS workload role.
# BEDROCK_MODEL_ID=
# AWS_REGION=us-east-1
# CloudFront origin protection; deployment supplies this, never a NEXT_PUBLIC variable.
# PENNYAHEAD_ORIGIN_TOKEN=
# Optional read-only /sandbox view for one synthetic Plaid test Item.
# PENNYAHEAD_PLAID_SANDBOX_ENABLED=true
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ACCESS_TOKEN=
